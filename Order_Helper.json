    {
      "parameters": {
        "jsCode": "const currentYear = new Date().getFullYear();\nconst lastOrderId = $input.first().json.LastOrderID;\n\nconst [lastYear, lastSequence] = lastOrderId.split(\"-\");\n\nconst nextSequence =\n  Number(lastYear) === currentYear\n    ? Number(lastSequence) + 1\n    : 1;\n\nconst newOrderId = `${currentYear}-${String(nextSequence).padStart(5, \"0\")}`;\n\nreturn [\n  {\n    json: {\n      lastOrderId,\n      newOrderId,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
